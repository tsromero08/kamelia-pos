# ─── Sistema POS de Restaurante — configuración de producción ───────────
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env`
# al repositorio.
#
# Para personalizar marca, nombres y datos del restaurante, edita el archivo
# `restaurant.config.json` en la raíz y ejecuta:  python personalizar.py

# Base de datos
# Por defecto SQLite (archivo local). Para producción usa PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/restaurant_pos
DATABASE_URL=sqlite:///./restaurant_pos.db

# ─── Seguridad JWT ──────────────────────────────────────────────────────
# IMPORTANTE: genera una clave aleatoria larga en producción:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-WITH-RANDOM-64-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Primer admin (se crea automáticamente al primer arranque) ──────────
# Si no se define, se toma del restaurant.config.json (admin@<email_domain>)
FIRST_ADMIN_EMAIL=admin@restaurante.local
FIRST_ADMIN_PASSWORD=CambiaEstaClave123
FIRST_ADMIN_NAME=Administrador

# ─── CORS (orígenes permitidos) ─────────────────────────────────────────
# Lista separada por comas o JSON. En producción restringe a tu dominio.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ─── Inventario ─────────────────────────────────────────────────────────
# Si True, bloquea la venta cuando el stock está por debajo del mínimo.
BLOCK_SALE_ON_LOW_STOCK=False

# ─── Modo debug ─────────────────────────────────────────────────────────
# En producción dejar False (oculta /docs y /openapi.json)
DEBUG=False

# ─── Código de Acceso Especial ──────────────────────────────────────────
# Default inicial. Puede cambiarse desde la UI (Usuarios → Cambiar código).
# El cambio se persiste en backend/data/system_settings.json.
SPECIAL_ACCESS_CODE=ACCESS2026

# ─── Licencia Software Titanova ─────────────────────────────────────────
LICENSE_KEY=TITANOVA-DEMO
LICENSE_CLIENT=Cliente Demo
# Formato YYYY-MM-DD. Vacío = sin vencimiento.
LICENSE_EXPIRES=
LICENSE_CONTACT=Software Titanova - 3013896861

# ─── Branding por env (opcional, sobreescribe restaurant.config.json) ───
# Si quieres setear marca por ENV sin tocar el JSON, descomenta:
# BRAND_BUSINESS_NAME=Pizzería Lupita
# BRAND_BUSINESS_NIT=901234567-8
# BRAND_BUSINESS_PHONE=3001234567
# BRAND_SYSTEM_EMAIL_DOMAIN=pizzerialupita.com
