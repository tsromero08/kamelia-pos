FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Producción: sin --reload, con 2 workers para manejar más usuarios simultáneos
CMD ["sh", "-c", "python -m app.db.seed && alembic stamp head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
